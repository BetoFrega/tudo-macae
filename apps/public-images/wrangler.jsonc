{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tudo-macae-public-images",
  "main": "index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_HOST": "images.localhost",
    "EDITORIAL_ORIGIN": ""
  },
  "env": {
    "production": {
      "name": "tudo-macae-public-images-production",
      "services": [{ "binding": "EDITORIAL_ORIGIN_SERVICE", "service": "tudo-macae-www-origin-production" }],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "routes": [
        {
          "pattern": "images.tudomacae.com.br/v1/*",
          "zone_name": "tudomacae.com.br"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "CLASSIFIEDS_ORIGIN": "",
        "PUBLIC_HOST": "images.tudomacae.com.br",
        "EDITORIAL_ORIGIN": "https://www.tudomacae.com.br"
      }
    }
  }
}
