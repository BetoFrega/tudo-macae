{
  "ref": "apex_to_canonical_www",
  "description": "Apex to canonical www",
  "expression": "(http.host eq \"tudomacae.com.br\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "target_url": {
        "expression": "concat(\"https://www.tudomacae.com.br\", http.request.uri.path)"
      },
      "status_code": 301,
      "preserve_query_string": true
    }
  },
  "enabled": true
}
