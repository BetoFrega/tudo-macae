  "scripts": {
    "dev": "node bin/dev.mjs",
    "dev:full": "DEMO_SEED_IMAGES=1 pnpm run dev",
    "test": "node bin/vitest-collection.mjs",
    "test:e2e": "pnpm --filter @tudomacae/e2e run test:e2e",
    "test:e2e:diagnostic": "pnpm --filter @tudomacae/e2e run test:e2e:diagnostic",
    "test:e2e:full": "pnpm --filter @tudomacae/e2e run test:e2e:full",
    "test:e2e:full:diagnostic": "pnpm --filter @tudomacae/e2e run test:e2e:full:diagnostic",
    "test:harness": "pnpm --filter @tudomacae/e2e run test:harness",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "pnpm run check:harness && pnpm run lint:boundaries && eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:diagnostic": "eslint --format ./bin/eslint-compact-formatter.mjs",
    "lint:boundaries": "depcruise src/packages packages apps/www-origin apps/web-workers apps/public-images apps/public-article-index apps/site-search apps/api-worker && node bin/domain-seams.mjs",
    "build:check": "node bin/build-check.mjs",
    "test:mutation": "node bin/run-mutation-tiers.mjs",
    "test:mutation:pure": "stryker run stryker.pure.config.mjs",
    "test:mutation:component": "stryker run stryker.component.config.mjs",
    "test:mutation:integration": "node bin/test-integration.mjs --mutation",
    "probe:edge": "node bin/probe-edge.mjs",
    "probe:image-canary": "node bin/probe-public-image-canary.mjs",
    "probe:image-revocation": "node bin/probe-public-image-revocation.mjs",
    "check:harness": "node bin/check-agent-harness.mjs",
    "product:sync": "node bin/sync-product-md.mjs",
    "help": "node bin/scripts-help.mjs",
    "build": "next build",
    "start": "node bin/start-app.mjs",
    "prepare": "husky",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:integration": "node bin/test-integration.mjs",
    "test:worker": "vitest run --config vitest.worker.config.mts",
    "typecheck:worker": "turbo run typecheck --only --filter='./apps/*'"
  },
