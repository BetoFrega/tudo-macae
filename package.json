{
  "name": "macae-classificados",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node bin/dev.mjs",
    "dev:full": "DEMO_SEED_IMAGES=1 npm run dev",
    "test": "node bin/vitest-collection.mjs",
    "test:e2e": "npm run test:e2e --workspace=@tudomacae/e2e --",
    "test:e2e:diagnostic": "npm run test:e2e:diagnostic --workspace=@tudomacae/e2e --",
    "test:e2e:full": "npm run test:e2e:full --workspace=@tudomacae/e2e --",
    "test:e2e:full:diagnostic": "npm run test:e2e:full:diagnostic --workspace=@tudomacae/e2e --",
    "test:harness": "npm run test:harness --workspace=@tudomacae/e2e --",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "npm run check:harness && npm run lint:boundaries && eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:diagnostic": "eslint --format ./bin/eslint-compact-formatter.mjs",
    "lint:boundaries": "depcruise src/packages packages apps/www-origin apps/web-workers apps/public-images apps/public-article-index apps/site-search apps/api-worker && node bin/domain-seams.mjs",
    "build:check": "node bin/build-check.mjs",
    "test:mutation": "node bin/run-mutation-tiers.mjs",
    "test:mutation:pure": "stryker run stryker.pure.config.mjs",
    "test:mutation:component": "stryker run stryker.component.config.mjs",
    "test:mutation:integration": "node bin/test-integration.mjs --mutation",
    "probe:edge": "node bin/probe-edge.mjs",
    "probe:image-canary": "node bin/probe-public-image-canary.mjs",
    "probe:image-revocation": "node bin/probe-public-image-revocation.mjs",
    "check:harness": "node bin/check-agent-harness.mjs",
    "product:sync": "node bin/sync-product-md.mjs",
    "help": "node bin/scripts-help.mjs",
    "build": "next build",
    "start": "node bin/start-app.mjs",
    "prepare": "husky",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:integration": "node bin/test-integration.mjs",
    "test:worker": "vitest run --config vitest.worker.config.mts",
    "typecheck:worker": "tsc --noEmit --project apps/public-images/tsconfig.json && tsc --noEmit --project apps/public-article-index/tsconfig.json && tsc --noEmit --project apps/www-origin/tsconfig.json && tsc --noEmit --project apps/site-search/tsconfig.json && tsc --noEmit --project apps/api-worker/tsconfig.json"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tudomacae/ads": "*",
    "@tudomacae/advertiser-identity": "*",
    "@tudomacae/authentication": "*",
    "@tudomacae/authentication-client": "*",
    "@tudomacae/categories": "*",
    "@tudomacae/civil-time": "*",
    "@tudomacae/classifieds-client": "*",
    "@tudomacae/classifieds-persistence": "*",
    "@tudomacae/design-foundations": "*",
    "@tudomacae/editorial-access": "*",
    "@tudomacae/editorial-blog": "*",
    "@tudomacae/editorial-media": "*",
    "@tudomacae/editorial-persistence": "*",
    "@tudomacae/editorial-planning": "*",
    "@tudomacae/editorial-sourcing": "*",
    "@tudomacae/media": "*",
    "@tudomacae/media-files": "*",
    "@tudomacae/public-image-delivery": "*",
    "@tudomacae/react-primitives": "*",
    "@tudomacae/site-layout": "*",
    "@tudomacae/site-search": "*",
    "@tudomacae/terms-page": "*",
    "@tudomacae/text-normalization": "*",
    "@tudomacae/www-origin-routing": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "^16.4.2",
    "posthog-js": "^1.438.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.0"
    },
    "nx": {
      "axios": "1.20.0",
      "brace-expansion": "5.0.12",
      "smol-toml": "1.7.1"
    },
    "miniflare": {
      "undici": "7.29.1"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/css": "^2.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@posthog/cli": "^0.18.10",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tudomacae/article-index-test-runtime": "*",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vinext/cloudflare": "^1.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-yml": "^3.9.0",
    "fflate": "0.8.3",
    "google-auth-library": "^11.2.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "miniflare": "^5.20260918.0-alpha",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-csstree": "^0.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "turbo": "2.11.9",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vinext": "^1.0.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "yaml": "^2.9.1"
  },
  "type": "module",
  "packageManager": "npm@10.9.9"
}
