{
  "name": "@tudomacae/e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node bin/playwright.mjs",
    "test:e2e": "node bin/playwright.mjs",
    "test:e2e:diagnostic": "node bin/playwright.mjs --max-failures=0",
    "test:e2e:full": "node _helpers/offering-catalog-runner.mjs test:e2e -- --config playwright.full.config.ts",
    "test:e2e:full:diagnostic": "node _helpers/offering-catalog-runner.mjs test:e2e -- --config playwright.full.config.ts --max-failures=0",
    "test:harness": "node bin/test-harness.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "zod": "^4.6.7",
    "@types/node": "^26",
    "typescript": "^6",
    "@playwright/test": "^1.63.0",
    "web-workers-app": "workspace:*",
    "www-origin-worker": "workspace:*",
    "@tudomacae/terms-page": "workspace:*",
    "@tudomacae/www-origin-routing": "workspace:*",
    "public-article-index-worker": "workspace:*",
    "@tudomacae/article-index-test-runtime": "workspace:*",
    "public-images-worker": "workspace:*",
    "@tudomacae/site-search": "workspace:*",
    "site-search-worker": "workspace:*",
    "@tudomacae/authentication": "workspace:*",
    "@tudomacae/media": "workspace:*",
    "@tudomacae/media-files": "workspace:*",
    "@tudomacae/civil-time": "workspace:*",
    "@tudomacae/ads": "workspace:*",
    "@tudomacae/text-normalization": "workspace:*",
    "@tudomacae/advertiser-identity": "workspace:*",
    "@tudomacae/categories": "workspace:*",
    "@tudomacae/editorial-access": "workspace:*",
    "@tudomacae/editorial-blog": "workspace:*",
    "@tudomacae/editorial-sourcing": "workspace:*",
    "@tudomacae/editorial-planning": "workspace:*",
    "@tudomacae/classifieds-client": "workspace:*"
  }
}
